{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["chrome", "node"],
    "noEmit": true
  },
  "include": ["src", "tests", "playwright.config.ts", "playwright.h.config.ts", "vitest.config.ts"]
}
